#!/usr/bin/env python3
"""Broker daemon entry point (installed at /usr/local/bin/faramir-broker)."""

from __future__ import annotations

import os
import sys

sys.path.insert(0, os.environ.get("FARAMIR_LIB", "/usr/local/lib/faramir"))

from faramir.server import main  # noqa: E402

if __name__ == "__main__":
    sys.exit(main())
