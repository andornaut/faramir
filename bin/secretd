#!/usr/bin/env python3
"""secretd entry point (installed at /usr/local/bin/secretd)."""

from __future__ import annotations

import os
import sys

sys.path.insert(0, os.environ.get("SECRETD_LIB", "/usr/local/lib/secretd"))

from secretd.server import main  # noqa: E402

if __name__ == "__main__":
    sys.exit(main())
