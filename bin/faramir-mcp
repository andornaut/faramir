#!/usr/bin/env python3
"""MCP (stdio) server exposing the broker to a coding agent.

A distinct tool is far more discoverable to a model than a convention
documented in prose, so the interesting work here is the tool descriptions:
they have to make it obvious that ``faramir_run`` is the *only* way to run a
command that needs credentials, and that secrets are named, never pasted.

Protocol: JSON-RPC 2.0 over stdio, MCP 2025-06-18.  Stdlib only.
"""

from __future__ import annotations

import json
import os
import sys

sys.path.insert(0, os.environ.get("FARAMIR_LIB", "/usr/local/lib/faramir"))

from faramir.client import DEFAULT_SOCKET, BrokerUnavailable, call  # noqa: E402

SERVER_NAME = "faramir"
SERVER_VERSION = "1.0.0"
PROTOCOL_VERSION = "2025-06-18"
SOCKET = os.environ.get("FARAMIR_SOCKET", DEFAULT_SOCKET)

TOOLS = [
    {
        "name": "faramir_run",
        "description": (
            "Run a command that needs credentials. This is the ONLY way to run such "
            "a command: the credentials do not exist in your environment, and reading "
            "or decrypting the secret store directly is blocked.\n\n"
            "The command runs as a separate uid that holds the keys. Output comes back "
            "with every known secret value replaced by a stable «SECRET:ref» token, so "
            "you can confirm a credential reached the right place without ever seeing "
            "it. Do not attempt to work around this — transformed output (base64, rev, "
            "cut) is a policy violation, not a puzzle.\n\n"
            "Secrets are referenced by name using secret:// URIs and are injected as "
            "environment variables only; they are never substituted into the command "
            "line. Call faramir_list_secrets to discover available names.\n\n"
            "Example: cmd=[\"printenv\",\"ROUTER_PW\"], "
            "env_refs={\"ROUTER_PW\":\"secret://home/router/admin\"}. What you may "
            "run is whatever the operator's allowlist permits; call faramir_status "
            "for the rule names.\n"
            "For a pipeline, pass cmd=[\"bash\",\"-lc\",\"…\"] explicitly (subject to "
            "the same allowlist)."
        ),
        "inputSchema": {
            "type": "object",
            "properties": {
                "cmd": {
                    "type": "array",
                    "items": {"type": "string"},
                    "minItems": 1,
                    "description": "argv array. Not a shell string — no shell is spawned for you.",
                },
                "env_refs": {
                    "type": "object",
                    "additionalProperties": {"type": "string"},
                    "description": "Map of ENV_VAR name -> secret:// URI to inject.",
                },
                "cwd": {
                    "type": "string",
                    "description": "Absolute working directory. Defaults to the broker's checkout.",
                },
                "timeout_sec": {
                    "type": "integer",
                    "description": "Seconds before the command is killed. Default 600.",
                },
            },
            "required": ["cmd"],
        },
    },
    {
        "name": "faramir_list_secrets",
        "description": (
            "List the secret:// references the broker can inject. Returns names only — "
            "never values. Use this to find the right ref for faramir_run's env_refs."
        ),
        "inputSchema": {"type": "object", "properties": {}},
    },
    {
        "name": "faramir_sync",
        "description": (
            "Promote committed work from the agent working tree into the broker's "
            "execution checkout. The broker only executes committed content, so after "
            "editing and committing a playbook you must call this before faramir_run "
            "will see the change."
        ),
        "inputSchema": {
            "type": "object",
            "properties": {
                "ref": {"type": "string", "description": "Git ref to promote. Default HEAD."}
            },
        },
    },
    {
        "name": "faramir_status",
        "description": (
            "Show broker configuration: which secret files are loaded, how many refs "
            "exist, which commands the allowlist permits, and any secrets too short to "
            "be redacted safely."
        ),
        "inputSchema": {"type": "object", "properties": {}},
    },
]


def _text(content: str, is_error: bool = False) -> dict:
    return {"content": [{"type": "text", "text": content}], "isError": is_error}


def _format(response: dict) -> dict:
    if response.get("error"):
        err = response["error"]
        detail = f"{err['code']}: {err['message']}"
        if response.get("log_id"):
            detail += f"\n(operator can inspect log_id {response['log_id']})"
        return _text(detail, is_error=True)

    parts = [response.get("output", "")]
    meta = []
    code = response.get("exit_code")
    if code is not None:
        meta.append(f"exit_code={code}")
    if response.get("redactions"):
        meta.append(
            "redacted: "
            + ", ".join(f"{r['token']} ×{r['count']}" for r in response["redactions"])
        )
    if response.get("truncated"):
        meta.append("output truncated")
    if response.get("timed_out"):
        meta.append("timed out")
    if response.get("log_id"):
        meta.append(f"log_id={response['log_id']}")
    if meta:
        parts.append("\n[" + "; ".join(meta) + "]")
    return _text("".join(parts), is_error=bool(code))


def call_tool(name: str, arguments: dict) -> dict:
    if name == "faramir_run":
        request = {"op": "exec", "cmd": arguments.get("cmd") or []}
        for key in ("env_refs", "cwd", "timeout_sec"):
            if arguments.get(key):
                request[key] = arguments[key]
    elif name == "faramir_list_secrets":
        request = {"op": "list_secrets"}
    elif name == "faramir_sync":
        request = {"op": "sync"}
        if arguments.get("ref"):
            request["ref"] = arguments["ref"]
    elif name == "faramir_status":
        request = {"op": "status"}
    else:
        return _text(f"unknown tool: {name}", is_error=True)

    try:
        return _format(call(request, SOCKET))
    except BrokerUnavailable as exc:
        return _text(f"secret broker unavailable: {exc}", is_error=True)


def handle(message: dict) -> dict | None:
    method = message.get("method")
    msg_id = message.get("id")
    params = message.get("params") or {}

    if method == "initialize":
        result = {
            "protocolVersion": params.get("protocolVersion", PROTOCOL_VERSION),
            "capabilities": {"tools": {"listChanged": False}},
            "serverInfo": {"name": SERVER_NAME, "version": SERVER_VERSION},
            "instructions": (
                "Any command that needs a credential must go through faramir_run. "
                "Secrets are referenced by name (secret://…); their values are never "
                "visible to you and never need to be."
            ),
        }
    elif method == "tools/list":
        result = {"tools": TOOLS}
    elif method == "tools/call":
        result = call_tool(params.get("name", ""), params.get("arguments") or {})
    elif method == "ping":
        result = {}
    elif method and method.startswith("notifications/"):
        return None
    else:
        if msg_id is None:
            return None
        return {
            "jsonrpc": "2.0",
            "id": msg_id,
            "error": {"code": -32601, "message": f"method not found: {method}"},
        }

    if msg_id is None:
        return None
    return {"jsonrpc": "2.0", "id": msg_id, "result": result}


def main() -> int:
    for line in sys.stdin:
        line = line.strip()
        if not line:
            continue
        try:
            message = json.loads(line)
        except json.JSONDecodeError:
            sys.stdout.write(
                json.dumps(
                    {
                        "jsonrpc": "2.0",
                        "id": None,
                        "error": {"code": -32700, "message": "parse error"},
                    }
                )
                + "\n"
            )
            sys.stdout.flush()
            continue
        response = handle(message)
        if response is not None:
            sys.stdout.write(json.dumps(response, ensure_ascii=False) + "\n")
            sys.stdout.flush()
    return 0


if __name__ == "__main__":
    sys.exit(main())
