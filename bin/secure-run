#!/usr/bin/env python3
"""secure-run -- run a command that needs credentials, without seeing them.

    secure-run --env ROUTER_PW=secret://home/router/admin -- \
        ansible-playbook site.yml --limit routers

    secure-run --list-secrets
    secure-run --sync            # promote committed work into the broker checkout
    secure-run --status

The command runs as the broker's uid.  Output comes back with every known
secret replaced by «SECRET:ref».
"""

from __future__ import annotations

import argparse
import json
import os
import sys

sys.path.insert(0, os.environ.get("SECRETD_LIB", "/usr/local/lib/secretd"))

from secretd.client import DEFAULT_SOCKET, BrokerUnavailable, call  # noqa: E402


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        prog="secure-run",
        description="Run a credential-bearing command through the secret broker.",
        epilog="Secrets are injected as environment variables only; they are "
        "never substituted into the command line.",
    )
    parser.add_argument(
        "-e",
        "--env",
        action="append",
        default=[],
        metavar="NAME=secret://ref",
        help="bind a secret to an environment variable (repeatable)",
    )
    parser.add_argument("-C", "--cwd", help="working directory for the command")
    parser.add_argument("-t", "--timeout", type=int, help="timeout in seconds")
    parser.add_argument("--socket", default=DEFAULT_SOCKET, help="broker socket path")
    parser.add_argument("--json", action="store_true", help="print the raw response")
    parser.add_argument("--quiet", action="store_true", help="suppress the redaction summary")
    parser.add_argument("--list-secrets", action="store_true", help="list secret refs")
    parser.add_argument("--status", action="store_true", help="show broker status")
    parser.add_argument("--sync", action="store_true", help="git-sync the broker checkout")
    parser.add_argument("--ref", help="ref to sync (default: HEAD of the agent tree)")
    parser.add_argument("command", nargs=argparse.REMAINDER, help="-- command [args…]")
    return parser


def parse_env(pairs: list[str]) -> dict[str, str]:
    out: dict[str, str] = {}
    for pair in pairs:
        name, sep, uri = pair.partition("=")
        if not sep or not name:
            raise SystemExit(f"secure-run: bad --env {pair!r}; expected NAME=secret://ref")
        if not uri.startswith("secret://"):
            raise SystemExit(
                f"secure-run: --env {name} must reference secret://…, not a literal value"
            )
        out[name] = uri
    return out


def main(argv: list[str] | None = None) -> int:
    args = build_parser().parse_args(argv)
    cmd = args.command[1:] if args.command[:1] == ["--"] else args.command

    if args.status:
        request = {"op": "status"}
    elif args.list_secrets:
        request = {"op": "list_secrets"}
    elif args.sync:
        request = {"op": "sync", **({"ref": args.ref} if args.ref else {})}
    else:
        if not cmd:
            build_parser().print_usage(sys.stderr)
            print("secure-run: no command given", file=sys.stderr)
            return 2
        request = {"op": "exec", "cmd": cmd, "env_refs": parse_env(args.env)}
        if args.cwd:
            request["cwd"] = args.cwd
        if args.timeout:
            request["timeout_sec"] = args.timeout

    try:
        response = call(request, args.socket)
    except BrokerUnavailable as exc:
        print(f"secure-run: {exc}", file=sys.stderr)
        return 69  # EX_UNAVAILABLE

    if args.json:
        json.dump(response, sys.stdout, indent=2, ensure_ascii=False)
        sys.stdout.write("\n")
        return 0 if not response.get("error") else 1

    if response.get("error"):
        err = response["error"]
        print(f"secure-run: {err['code']}: {err['message']}", file=sys.stderr)
        if response.get("log_id"):
            print(f"secure-run: log_id={response['log_id']}", file=sys.stderr)
        return 1

    sys.stdout.write(response.get("output", ""))
    sys.stdout.flush()

    if not args.quiet:
        notes = []
        if response.get("redactions"):
            notes.append(
                "redacted " + ", ".join(f"{r['token']}×{r['count']}" for r in response["redactions"])
            )
        if response.get("truncated"):
            notes.append("output truncated")
        if response.get("timed_out"):
            notes.append("timed out")
        if response.get("log_id"):
            notes.append(f"log_id={response['log_id']}")
        if notes:
            print(f"[secure-run] {'; '.join(notes)}", file=sys.stderr)

    code = response.get("exit_code")
    return int(code) if isinstance(code, int) else 0


if __name__ == "__main__":
    sys.exit(main())
