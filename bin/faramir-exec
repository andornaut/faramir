#!/usr/bin/env python3
"""Executor entry point (installed at /usr/local/bin/faramir-exec).

Forks brokered commands under its own uid.  It holds no secrets: the broker
sends it an already-authorised argv and the environment to run it with, and
keeps the PTY master for itself.
"""

from __future__ import annotations

import os
import sys

sys.path.insert(0, os.environ.get("FARAMIR_LIB", "/usr/local/lib/faramir"))

from faramir.execserver import main  # noqa: E402

if __name__ == "__main__":
    sys.exit(main())
