#!/usr/bin/env python3
"""Keeper entry point (installed at /usr/local/bin/faramir-keeper).

Runs as its own uid, holds the age key, and serves decrypted values to the
broker.  Nothing it can be asked returns the key itself.
"""

from __future__ import annotations

import os
import sys

sys.path.insert(0, os.environ.get("FARAMIR_LIB", "/usr/local/lib/faramir"))

from faramir.keeper import main  # noqa: E402

if __name__ == "__main__":
    sys.exit(main())
