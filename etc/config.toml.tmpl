# {{.ConfigFile}} -- broker configuration.
#
# Written by `faramir init` and REWRITTEN BY EVERY RUN.  Do not edit it.
# Your settings go in a drop-in beside it, which init never touches:
#
#   {{.ConfigDir}}/config.d/50-local.toml     yours
#   {{.ConfigDir}}/config.d/<consumer>.toml   one per consumer of the broker
#
# Drop-ins merge over this file in lexical order.  [secrets] files accumulates
# rather than replacing, and decrypt_command is refused if a drop-in sets it
# again.  Every value init derives from a flag or from the install is refused
# outright: the socket paths, allowed_group, allowed_user, the keeper's
# age_key_file and age_key_credential, the whole of [ssh], and audit log_path.
# Re-running `faramir init` is what changes the ones a flag reaches; the rest
# come from paths fixed at build time.  What is left is a default, and yours
# to set.
#
# Check a config with:  faramir broker -c FILE --check
# See README.md and docs/design.md.

[server]
socket_path = "{{.RunDir}}/broker.sock"
max_concurrency = 4
max_request_bytes = 262144
# Checked with SO_PEERCRED, on top of the socket mode.  Primary or supplementary.
allowed_group = "{{.ClientGroup}}"

# Holds the age key: its own uid, execs nothing but sops.
[keeper]
socket_path = "{{.RunDir}}/keeper.sock"
allowed_user = "{{.BrokerUser}}"
# Name of the systemd LoadCredential= entry in faramir-keeper.service.
age_key_credential = "age_key"
# Where the keeper reads the key when there is no systemd credential.
age_key_file = "{{.AgeKeyPath}}"

# Forks brokered commands.  Its uid holds no key, values, audit log or SSH keys.
# No max_concurrency: the broker holds one [server] slot for the whole of each
# child and is this socket's only client.
[executor]
socket_path = "{{.RunDir}}/exec.sock"
allowed_user = "{{.BrokerUser}}"

[exec]
default_timeout_sec = 600
max_timeout_sec = 3600
max_output_bytes = 1048576
term_cols = 120
term_rows = 40
kill_grace_sec = 5

# The child's entire environment; the broker's own is never inherited.
[exec.base_env]
PATH = "/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
TERM = "xterm-256color"
LANG = "C.UTF-8"
LC_ALL = "C.UTF-8"
DEBIAN_FRONTEND = "noninteractive"

# Loaded into an agent the broker owns; the child gets SSH_AUTH_SOCK only.
# One key, minted by init, which holds both halves and prints the public one
# every run to put in a managed host's authorized_keys.  init owns this value, so
# a drop-in setting it is refused: move the key, or adopt one of your own, with
# `faramir init --ssh-key`.
[ssh]
key = "{{.SSHKey}}"
agent_socket = "{{.RunDir}}/ssh-agent.sock"
exec_group = "{{.ExecGroup}}"
# Resolved on PATH by init; the broker execs these as its own uid.
ssh_agent = "{{.SshAgent}}"
ssh_add = "{{.SshAdd}}"

[secrets]
# Every sops file the keeper manages.  ALL of their values are redacted, not
# only the injected ones.  Entries are globs, so naming the directory picks up
# a file added beside the others; one that matches nothing leaves the broker
# refusing exec and redact, and fails --check.
files = ["{{.SecretsDir}}/*.sops.yml"]
decrypt_command = ["sops", "--output-type", "json", "--decrypt", "{file}"]
# How often the broker may ask the keeper whether a managed file changed.
refresh_interval_sec = 5
# A shorter value would match inside ordinary words, so the broker refuses to
# load it.  Length only; this judges nothing about the value.
min_length = 8

[audit]
log_path = "{{.LogDir}}/audit.log"
max_record_bytes = 4194304
