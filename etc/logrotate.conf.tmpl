# Rotation for the audit log: [audit] max_record_bytes bounds one record, not
# the file.
#
# su is required, logrotate refusing to act on a directory it does not own.
#
# No copytruncate and no postrotate signal: the broker opens the log per record
# and passes O_CREATE, so a rename is safe and the next write reopens by path.
#
# 0600 on create, matching what the broker opens with; logrotate would otherwise
# apply the daemon's umask.
{{.LogDir}}/audit.log {
    su {{.BrokerUser}} {{.BrokerUser}}
    create 0600 {{.BrokerUser}} {{.BrokerUser}}
    weekly
    rotate 8
    maxsize 16M
    compress
    missingok
    notifempty
}
