// faramir: run every shell command under the redactor, and refuse the ones the
// deny list names.
//
// `faramir init-project --agent pi` writes this into {{.Path}}, which pi loads
// once the project is trusted.
//
// A file of its own rather than the template the opencode and Kilo Code plugins
// share, because pi answers differently in both directions: a refusal is a
// value returned rather than an exception thrown, and a rewrite is a mutation
// of the event's own input rather than of an object the host passed in.  What
// is shared is the guard call and the fail-closed branches, and folding three
// dialects into one template would branch it exactly where a bug would live.
//
// pi ships no MCP, so the tools the other hosts reach through it are registered
// here instead.  Without them the guard's own refusal dead-ends: it tells the
// model to use faramir_run, and on this host there would be no such tool.
//
// They shell out to the CLI rather than speaking to the broker socket, so there
// is one client of the wire protocol rather than two, and this file cannot
// drift from docs/protocol.md.  What it formats is the JSON the CLI already
// prints, in the shape internal/mcp returns.

// No type annotations, though the extension pi loads is a .ts: TypeScript takes
// plain JavaScript, and without them this file runs under a bare node, which is
// what lets the tests drive the shipped bytes rather than a stripped copy of
// them.  Everything here was `any` in any case.
import { spawnSync } from "node:child_process"

// The installed path, not an environment variable: see the note in the
// opencode plugin.  The file is the operator's to edit, so this closes one
// route rather than being a boundary.
const CLI = "{{.BinDir}}/faramir"
const HOST = "pi"

// Guarded by shape rather than by name: anything carrying a command string is
// put to the guard whatever the tool is called.  The names are what makes a
// known shell tool arriving without one a refusal rather than a shrug.
const SHELL_TOOLS = new Set(["bash", "shell", "exec"])

// The paths this refuses to open, GENERATED from
// internal/install/protectedpaths.go: the same list the other four agents get,
// in the spelling this one can apply.  Nothing here is a path of its own.
//
// pi has no account-wide rule file to write them into, so they are applied here
// instead, and by shape rather than by tool name for the same reason the
// commands are: a file tool this does not know the name of still carries a path.
const PROTECTED_PATHS = [
{{- range $fragment := jsFragments }}
  {{ printf "%s" (quote $fragment) }},
{{- end }}
].map((source) => new RegExp(source))

// This install's own directories, which are literal rather than patterns: a
// config and store moved by --config-dir are the ones refused rather than the
// defaults.
// filter(Boolean) is not decoration: an empty string here would make every
// absolute path start with it, and refuse the whole filesystem.
const PROTECTED_DIRS = [
{{- range $dir := .Dirs }}
  {{ printf "%s" (quote $dir) }},
{{- end }}
].filter(Boolean)

// pathsIn is every string in a tool's input that could name a file, at any
// depth: a tool taking one path and a tool taking a list of them are the same
// question, and enumerating tool schemas is how one gets missed.
function pathsIn(value, depth = 0) {
  if (depth > 8) return []
  if (typeof value === "string") return [value]
  if (Array.isArray(value)) return value.flatMap((v) => pathsIn(v, depth + 1))
  if (value && typeof value === "object") {
    return Object.values(value).flatMap((v) => pathsIn(v, depth + 1))
  }
  return []
}

// refusedPath is the first path in this call that names key material, or "".
function refusedPath(input) {
  for (const candidate of pathsIn(input)) {
    if (PROTECTED_PATHS.some((re) => re.test(candidate))) return candidate
    if (PROTECTED_DIRS.some((dir) => candidate.startsWith(dir + "/"))) return candidate
  }
  return ""
}

// runCLI is one faramir invocation and its raw output.
function runCLI(args) {
  const result = spawnSync(CLI, args, { encoding: "utf8", timeout: 600000 })
  if (result.error || typeof result.stdout !== "string") {
    return { failed: `faramir: ${CLI} could not be run: ${result.error || "no output"}` }
  }
  return { stdout: result.stdout, stderr: String(result.stderr || ""), status: result.status }
}

// text is one tool result in pi's shape.
function text(body, isError = false) {
  return { content: [{ type: "text", text: body }], isError }
}

// describe renders a broker response the way the MCP server does, so what a
// model sees here is what it would see on any other host.
function describe(raw, stderr) {
  let r
  try {
    r = JSON.parse(raw)
  } catch {
    return text(stderr.trim() || "faramir: the broker's answer was not JSON", true)
  }
  if (r.error) {
    let detail = `${r.error.code}: ${r.error.message}`
    if (r.log_id) detail += `\n(operator can inspect log_id ${r.log_id})`
    return text(detail, true)
  }
  const meta = []
  if (typeof r.exit_code === "number") meta.push(`exit_code=${r.exit_code}`)
  if (r.redactions && r.redactions.length) {
    meta.push("redacted: " + r.redactions.map((x) => `${x.token} ×${x.count}`).join(", "))
  }
  if (r.truncated) meta.push("output truncated")
  if (r.timed_out) meta.push("timed out")
  if (r.log_id) meta.push(`log_id=${r.log_id}`)
  const body = (r.output || "") + (meta.length ? `\n[${meta.join("; ")}]` : "")
  return text(body, typeof r.exit_code === "number" && r.exit_code !== 0)
}

// What each tool is called, what it is for and what it takes, GENERATED from
// internal/mcp: pi ships no MCP, so the tools the other hosts reach through the
// server are registered below from that same list rather than from a copy of
// it.  Nothing here is a description of its own.
//
// What is this host's and stays below is the label and the body that runs the
// tool.  A model is told the same thing about a tool wherever it meets one.
const MCP_TOOLS = {{ mcpToolsJS "" }}

export default function faramir(pi) {
  pi.registerTool({
    ...MCP_TOOLS.faramir_run,
    label: "faramir run",
    async execute(_id, params) {
      const cmd = params && params.cmd
      if (!Array.isArray(cmd) || cmd.some((a) => typeof a !== "string")) {
        return text(
          'cmd must be an array of strings, not a shell string. Use ' +
            'cmd=["ansible-playbook","site.yml"], or cmd=["bash","-lc","a | b"] ' +
            "when you need a pipeline.",
          true,
        )
      }
      if (cmd.length === 0) return text("cmd must name a program: it is an empty array.", true)

      const args = ["run", "--json"]
      if (params.cwd) args.push("-C", String(params.cwd))
      if (params.timeout_sec) args.push("-t", String(params.timeout_sec))
      for (const [name, ref] of Object.entries(params.env_refs || {})) {
        args.push("--env", `${name}=${ref}`)
      }
      args.push("--", ...cmd)

      const out = runCLI(args)
      if (out.failed) return text(out.failed, true)
      return describe(out.stdout, out.stderr)
    },
  })

  pi.registerTool({
    ...MCP_TOOLS.faramir_list_secrets,
    label: "faramir list-secrets",
    async execute() {
      const out = runCLI(["list-secrets"])
      if (out.failed) return text(out.failed, true)
      return text(out.stdout || out.stderr, out.status !== 0)
    },
  })

  pi.on("tool_call", async (event) => {
    const input = event && event.input
    const command = input && input.command

    if (typeof command !== "string" || command === "") {
      if (SHELL_TOOLS.has(event && event.toolName)) {
        return {
          block: true,
          reason:
            `faramir: ${event.toolName} was called with no command string, so this ` +
            "extension could not guard it and the call was not made",
        }
      }
      // Not a command, so it is a file tool or something like one.  The other
      // agents refuse these through a rule file of their own; pi has none, so
      // the same list is applied here.
      const refused = refusedPath(input)
      if (refused) {
        return {
          block: true,
          reason:
            `faramir: ${refused} is key material or an encrypted store, and reading ` +
            "or writing it directly is refused. You do not need the value of a " +
            "secret to use it: name it as faramir://<ref> and run the command " +
            "through `faramir run`, which injects it and redacts the output",
        }
      }
      return
    }

    const result = spawnSync(CLI, ["guard", "--host", HOST], {
      input: JSON.stringify({ tool_name: event.toolName, tool_input: input }),
      encoding: "utf8",
      timeout: 10000,
    })

    // Fail closed: running the command without a decision would print whatever
    // it found straight into the transcript.
    if (result.error || result.status !== 0) {
      return {
        block: true,
        reason:
          `faramir: the guard did not answer, so this command was not run (${CLI} guard --host ${HOST})` +
          (result.stderr ? `: ${String(result.stderr).trim()}` : ""),
      }
    }

    // Nothing to say: a backgrounded command, or one already under the
    // redactor.  See docs/design.md.
    const text = (result.stdout || "").trim()
    if (!text) return

    let decision
    try {
      decision = JSON.parse(text)
    } catch {
      return {
        block: true,
        reason: "faramir: the guard's answer was not JSON, so this command was not run",
      }
    }

    switch (decision.decision) {
      case "deny":
        // Reaches the model, not the operator, and names the tool to use
        // instead.
        return { block: true, reason: decision.reason }
      case "rewrite":
        // event.input is the object pi executes from, so assigning into it is
        // how this hook changes a call.  Every field, not only the command.
        Object.assign(input, decision.tool_input)
        return
      default:
        return {
          block: true,
          reason:
            "faramir: the guard returned a decision this extension does not understand, " +
            "so this command was not run",
        }
    }
  })
}
