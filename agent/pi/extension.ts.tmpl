// faramir: run every shell command under the redactor, and refuse the ones the
// deny list names.
//
// `faramir init --agent pi` writes this into {{.Path}}, which pi loads for
// every project without the project being trusted. In a home rather than a
// tree: the wrapper, the redactor and the binary this execs are installed for
// the account, so nothing about guarding a command needs a tree.
//
// A file of its own rather than the template the opencode and Kilo Code plugins
// share, because pi answers differently in both directions: a refusal is a
// value returned rather than an exception thrown, and a rewrite is a mutation
// of the event's own input rather than of an object the host passed in. What
// is shared is the guard call and the fail-closed branches, and folding three
// dialects into one template would branch it exactly where a bug would live.
//
// It registers no tools. The route to the broker is `faramir run`, which is
// installed for the account and needs registering nowhere, and it is what the
// guard's own refusal names.

// No type annotations, though the extension pi loads is a .ts: TypeScript takes
// plain JavaScript, and without them this file runs under a bare node, which is
// what lets the tests drive the shipped bytes rather than a stripped copy of
// them. Everything here was `any` in any case.
import { spawnSync } from "node:child_process"

// The installed path, not an environment variable: see the note in the
// opencode plugin. The file is the operator's to edit, so this closes one
// route rather than being a boundary.
const CLI = "{{.BinDir}}/faramir"
const HOST = "pi"

// Guarded by shape rather than by name: anything carrying a command string is
// put to the guard whatever the tool is called. The names are what makes a
// known shell tool arriving without one a refusal rather than a shrug.
const SHELL_TOOLS = new Set(["bash", "shell", "exec"])

// whyNot is what to add to the message when the guard did not answer: what
// stopped it running, what it said on stderr, or the status it exited with.
// Without one of these the operator is told a command was not run and nothing
// about why, which is the same sentence for a missing binary and a guard that
// refused the payload.
function whyNot(result) {
  const said = result.stderr ? String(result.stderr).trim() : ""
  if (result.error) return `: ${result.error.message || result.error}`
  if (said) return `: ${said}`
  if (result.signal) return `: killed by ${result.signal}`
  return `: it exited ${result.status}`
}

export default function faramir(pi) {
  pi.on("tool_call", async (event) => {
    const input = event && event.input
    const command = input && input.command

    if (typeof command !== "string" || command === "") {
      if (SHELL_TOOLS.has(event && event.toolName)) {
        return {
          block: true,
          reason:
            `faramir: ${event.toolName} was called with no command string, so this ` +
            "extension could not guard it and the call was not made",
        }
      }
      // Not a command, so it is a file tool or something like one. pi has no
      // rule file of its own to refuse those, so they are asked about rather
      // than waved through, and asked of the guard: this extension decides
      // nothing, and one implementation of a rule cannot drift from another.
    }

    const result = spawnSync(CLI, ["guard", "--host", HOST], {
      input: JSON.stringify({ tool_name: event.toolName, tool_input: input }),
      encoding: "utf8",
      timeout: 10000,
    })

    // Fail closed: running the command without a decision would print whatever
    // it found straight into the transcript.
    //
    // On the exit status alone. A child that never started has none, so null
    // covers a guard that is not there, one killed by the timeout above and one
    // killed by a signal. `result.error` does not mean the same thing: it is also
    // set when this end's write to the guard's stdin does not finish, which a
    // guard that answers without draining its payload causes on a run that
    // worked. What it says instead is why, where there is a why to give.
    if (result.status !== 0) {
      return {
        block: true,
        reason:
          `faramir: the guard did not answer, so this command was not run (${CLI} guard --host ${HOST})` +
          whyNot(result),
      }
    }

    // Nothing to say: a backgrounded command, or one already under the
    // redactor. See docs/design.md.
    const text = (result.stdout || "").trim()
    if (!text) return

    let decision
    try {
      decision = JSON.parse(text)
    } catch {
      return {
        block: true,
        reason: "faramir: the guard's answer was not JSON, so this command was not run",
      }
    }

    switch (decision.decision) {
      case "deny":
        // Reaches the model, not the operator, and names the tool to use
        // instead.
        return { block: true, reason: decision.reason }
      case "rewrite": {
        // Held to carrying a command before anything is assigned. Object.assign
        // ignores null and undefined, and takes index properties off a string,
        // so a rewrite arriving without a usable tool_input would leave the
        // command as the model wrote it and this hook would return having
        // changed nothing: the one answer that runs unredacted rather than
        // failing closed.
        const rewritten = decision.tool_input
        if (!rewritten || typeof rewritten !== "object" || typeof rewritten.command !== "string") {
          return {
            block: true,
            reason:
              "faramir: the guard asked for a rewrite and named no command to run " +
              "instead, so this command was not run",
          }
        }
        // event.input is the object pi executes from, so assigning into it is
        // how this hook changes a call. Every field, not only the command.
        Object.assign(input, rewritten)
        return
      }
      default:
        return {
          block: true,
          reason:
            "faramir: the guard returned a decision this extension does not understand, " +
            "so this command was not run",
        }
    }
  })
}
