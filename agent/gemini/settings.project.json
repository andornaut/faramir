{
  "hooks": {
    "BeforeTool": [
      {
        "matcher": "run_shell_command",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/local/bin/faramir guard --host gemini",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "mcpServers": {
    "faramir": {
      "command": "/usr/local/bin/faramir",
      "args": ["mcp"],
      "env": {}
    }
  }
}
