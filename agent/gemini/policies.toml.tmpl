{{- /* One alternation for both rules: a wildcard inside a file name stays
inside it, and "not a quote and not a separator" is what that means whether the
name sits in a JSON value or in a JSON array. */ -}}
{{- $paths := regexAlternation `[^"/]*` -}}
{{- $dirs := "" -}}
{{- range $i, $dir := installDirs . -}}
  {{- if $i }}{{ $dirs = printf "%s|%s" $dirs (regexQuote $dir) }}{{ else }}{{ $dirs = regexQuote $dir }}{{ end -}}
{{- end -}}
# faramir: refuse to open key material, wherever the agent is working.  This
# takes nothing away: values reach a command through the broker.
#
# GENERATED from agent/gemini/policies.toml.tmpl.  The path list is not here: it
# is written once in internal/install/protectedpaths.go and rendered into every
# agent's own spelling, so adding a path is one line there and none here.  A
# list per agent is a list that drifts, and one of these rules did, matching
# nothing for want of a backslash while its siblings worked.
#
# Gemini CLI matches a regex against the tool's arguments serialised as JSON, so
# this is one rule per file tool with the paths as an alternation.  Tolerant of
# whitespace around the colon, the serialiser promising only "a stable JSON
# string".
#
# ".env" is matched as "/\.env", a dotfile rather than any name ending in those
# four characters: faramir.env holds refs and is meant to be read.
#
# priority 1000, so an allow rule written later does not outrank these; deny
# rather than ask_user, a prompt being something to click through.  The
# install's own directories go through regexQuote, these being regexes.
#
# `[^\]]`, with the bracket escaped, wherever a class excludes one: Gemini
# matches with JavaScript, where `[^]` is an empty negated class meaning any
# character, so an unescaped `[^]]*` reads as one character followed by literal
# brackets and the rule matches nothing at all.  Go and POSIX read the same text
# as "not a bracket", which is why the wrong spelling looks right.

# Reading, writing and editing a single file, refused for the same paths.  A
# value the agent cannot read is one it can still destroy, and an age key
# replaced is every managed file unreadable retroactively.
{{range $tool := list "read_file" "write_file" "replace"}}
[[rule]]
toolName = "{{$tool}}"
argsPattern = '"file_path"\s*:\s*"[^"]*({{$paths}})'
decision = "deny"
priority = 1000
{{end}}
# Reading a directory at once.  It takes include globs rather than a single
# path, so a deny covering only read_file would leave this open.  Its own shape,
# matching inside a JSON array rather than one value, from the same list.
[[rule]]
toolName = "read_many_files"
argsPattern = '"(include|exclude)"\s*:\s*\[[^\]]*({{$paths}})'
decision = "deny"
priority = 1000

# This install's own directories, named rather than pattern-matched, so a config
# and store moved into a home are the ones refused rather than the defaults.
{{range $tool := list "read_file" "write_file" "replace"}}
[[rule]]
toolName = "{{$tool}}"
argsPattern = '"file_path"\s*:\s*"({{$dirs}})/'
decision = "deny"
priority = 1000
{{end}}
