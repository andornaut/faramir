# faramir: refuse to open key material, wherever the agent is working.  This
# takes nothing away: values reach a command through the broker.
#
# Gemini CLI matches a regex against the tool's arguments serialised as JSON, so
# this is one rule per file tool with the paths as an alternation.  Tolerant of
# whitespace around the colon, the serialiser promising only "a stable JSON
# string".
#
# ".env" is matched as "/\.env", a dotfile rather than any name ending in those
# four characters: faramir.env holds refs and is meant to be read.
#
# priority 1000, so an allow rule written later does not outrank these; deny
# rather than ask_user, a prompt being something to click through.  The
# install's own directories go through regexQuote, these being regexes.

# Reading a single file.
[[rule]]
toolName = "read_file"
argsPattern = '"file_path"\s*:\s*"[^"]*(secrets[^"/]*\.ya?ml|[^"]*\.vault|vault\.yml|[^"]*\.sops\.(ya?ml|json)|/\.env[^"/]*|[^"]*\.faramir/|age\.key|sops/age/|\.config/sops/|[^"]*\.(key|pem)|credentials|id_(rsa|dsa|ecdsa|ed25519))'
decision = "deny"
priority = 1000

# Reading a directory at once. It takes include globs rather than a single
# path, so a deny covering only read_file would leave this open.
[[rule]]
toolName = "read_many_files"
argsPattern = '"(include|exclude)"\s*:\s*\[[^]]*(secrets[^"/]*\.ya?ml|\.vault|vault\.yml|\.sops\.(ya?ml|json)|/\.env|\.faramir/|age\.key|sops/age/|\.config/sops/|\.(key|pem)|credentials|id_(rsa|dsa|ecdsa|ed25519))'
decision = "deny"
priority = 1000

# Writing and editing, refused for the same paths. A value the agent cannot read
# is one it can still destroy, and an age key replaced is every managed file
# unreadable retroactively.
[[rule]]
toolName = "write_file"
argsPattern = '"file_path"\s*:\s*"[^"]*(secrets[^"/]*\.ya?ml|[^"]*\.vault|vault\.yml|[^"]*\.sops\.(ya?ml|json)|/\.env[^"/]*|[^"]*\.faramir/|age\.key|sops/age/|\.config/sops/|[^"]*\.(key|pem)|credentials|id_(rsa|dsa|ecdsa|ed25519))'
decision = "deny"
priority = 1000

[[rule]]
toolName = "replace"
argsPattern = '"file_path"\s*:\s*"[^"]*(secrets[^"/]*\.ya?ml|[^"]*\.vault|vault\.yml|[^"]*\.sops\.(ya?ml|json)|/\.env[^"/]*|[^"]*\.faramir/|age\.key|sops/age/|\.config/sops/|[^"]*\.(key|pem)|credentials|id_(rsa|dsa|ecdsa|ed25519))'
decision = "deny"
priority = 1000

# This install's own directories, named rather than pattern-matched, so a config
# and store moved into a home are the ones refused rather than the defaults.
[[rule]]
toolName = "read_file"
argsPattern = '"file_path"\s*:\s*"({{ regexQuote .ConfigDir }}|{{ regexQuote .SecretsDir }}|{{ regexQuote .LogDir }}|{{ regexQuote .LibexecDir }})/'
decision = "deny"
priority = 1000

[[rule]]
toolName = "write_file"
argsPattern = '"file_path"\s*:\s*"({{ regexQuote .ConfigDir }}|{{ regexQuote .SecretsDir }}|{{ regexQuote .LogDir }}|{{ regexQuote .LibexecDir }})/'
decision = "deny"
priority = 1000

[[rule]]
toolName = "replace"
argsPattern = '"file_path"\s*:\s*"({{ regexQuote .ConfigDir }}|{{ regexQuote .SecretsDir }}|{{ regexQuote .LogDir }}|{{ regexQuote .LibexecDir }})/'
decision = "deny"
priority = 1000
