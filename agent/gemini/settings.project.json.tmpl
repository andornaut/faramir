{
  "hooks": {
    "BeforeTool": [
      {
        "matcher": "run_shell_command",
        "hooks": [
          {
            "type": "command",
            "command": "{{.BinDir}}/faramir guard --host gemini",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "mcpServers": {
    "faramir": {
      "command": "{{.BinDir}}/faramir",
      "args": ["mcp"],
      "env": {}
    }
  }
}
