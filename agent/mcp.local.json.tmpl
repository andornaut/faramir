{{- /*
The MCP registration for the two plugin hosts, which name the file differently
and read the same shape into it: opencode.json in a tree for opencode, kilo.json
for Kilo Code.  One asset rather than two identical ones, so a change to how the
server is registered reaches both.  Should the two shapes ever diverge, split
this back into a file each rather than adding a knob.
*/ -}}
{
  "mcp": {
    "faramir": {
      "type": "local",
      "command": ["{{.BinDir}}/faramir", "mcp"],
      "enabled": true
    }
  }
}
