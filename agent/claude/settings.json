{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Read(**/secrets*.yml)",
      "Read(**/secrets*.yaml)",
      "Read(**/*.vault)",
      "Read(**/vault.yml)",
      "Read(**/*.sops.yml)",
      "Read(**/*.sops.yaml)",
      "Read(**/.env*)",
      "Read(/etc/faramir/**)",
      "Read(/var/log/faramir/**)",
      "Read(**/age.key)",
      "Read(**/*.key)",
      "Read(**/*.pem)",
      "Read(**/credentials)",
      "Read(**/id_rsa)",
      "Read(**/id_dsa)",
      "Read(**/id_ecdsa)",
      "Read(**/id_ed25519)"
    ]
  }
}
