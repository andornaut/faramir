{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Read(**/secrets*.yml)",
      "Read(**/secrets*.yaml)",
      "Read(**/*.vault)",
      "Read(**/vault.yml)",
      "Read(**/*.sops.yml)",
      "Read(**/*.sops.yaml)",
      "Read(**/*.sops.json)",
      "Read(**/.env*)",
      "Read({{.ConfigDir}}/**)",
      "Read({{.SecretsDir}}/**)",
      "Read({{.LogDir}}/**)",
      "Read(**/.faramir/**)",
      "Read(**/age.key)",
      "Read(**/sops/age/**)",
      "Read(**/.config/sops/**)",
      "Read(**/*.key)",
      "Read(**/*.pem)",
      "Read(**/credentials)",
      "Read(**/id_rsa)",
      "Read(**/id_dsa)",
      "Read(**/id_ecdsa)",
      "Read(**/id_ed25519)",

      "Edit(**/secrets*.yml)",
      "Edit(**/secrets*.yaml)",
      "Edit(**/*.vault)",
      "Edit(**/vault.yml)",
      "Edit(**/*.sops.yml)",
      "Edit(**/*.sops.yaml)",
      "Edit(**/*.sops.json)",
      "Edit({{.ConfigDir}}/**)",
      "Edit({{.SecretsDir}}/**)",
      "Edit(**/.faramir/**)",
      "Edit(**/age.key)",
      "Edit(**/sops/age/**)",
      "Edit(**/.config/sops/**)",
      "Edit(**/*.key)",
      "Edit(**/*.pem)",
      "Edit({{.LibexecDir}}/**)",

      "Write(**/secrets*.yml)",
      "Write(**/secrets*.yaml)",
      "Write(**/*.vault)",
      "Write(**/vault.yml)",
      "Write(**/*.sops.yml)",
      "Write(**/*.sops.yaml)",
      "Write(**/*.sops.json)",
      "Write({{.ConfigDir}}/**)",
      "Write({{.SecretsDir}}/**)",
      "Write(**/.faramir/**)",
      "Write(**/age.key)",
      "Write(**/sops/age/**)",
      "Write(**/.config/sops/**)",
      "Write(**/*.key)",
      "Write(**/*.pem)",
      "Write({{.LibexecDir}}/**)"
    ]
  }
}
