// faramir: run every shell command under the redactor, and refuse the ones the
// deny list names.
//
// `faramir init-project --agent {{.Agent}}` writes this into {{.Path}}, which
// {{.Agent}} loads at startup.
//
// It decides nothing: the deny list, the rewrite and what is left alone are
// `faramir guard`. This is the translation: a payload out, a decision back,
// applied rather than returned, the host having no reply document.
//
// One template renders this for both hosts, which differ only in what a module
// exports. They were two files that had to be kept in step by hand, and a fix
// to the guard call or to a fail-closed branch reaching one and not the other
// is the failure that costs a project its redaction silently.
//
// node:child_process rather than the Bun shell: the guard reads its payload on
// stdin, and this never builds a command line out of the model's text.
// spawnSync, the decision having to be applied before the hook returns.

import { spawnSync } from "node:child_process"

// The installed path, not an environment variable. The plugin is the
// operator's file to edit, so this is one route closed rather than a boundary:
// what it stops is a stray FARAMIR_CLI in the host's environment quietly
// deciding what guards it.
const CLI = "{{.BinDir}}/faramir"
const HOST = "{{.Agent}}"

// The tools known to run a shell command. This list is not what decides:
// anything whose arguments carry a command string is guarded whatever the tool
// is called, so a host that renames its shell tool or adds a second one stays
// covered without this being updated.
//
// What the list is for is the other direction. A tool named here arriving with
// no command string means the shape changed under us, and on a tool known to
// run commands that is a reason to stop rather than to shrug: the alternative
// is returning quietly and leaving the project unguarded.
const SHELL_TOOLS = new Set(["bash", "shell", "exec"])

// whyNot is what to add to the message when the guard did not answer: what
// stopped it running, what it said on stderr, or the status it exited with.
// Without one of these the operator is told a command was not run and nothing
// about why, which is the same sentence for a missing binary and a guard that
// refused the payload.
function whyNot(result) {
  const said = result.stderr ? String(result.stderr).trim() : ""
  if (result.error) return `: ${result.error.message || result.error}`
  if (said) return `: ${said}`
  if (result.signal) return `: killed by ${result.signal}`
  return `: it exited ${result.status}`
}

{{if .DefaultExport}}const faramir{{else}}export const faramir{{end}} = async () => ({
  "tool.execute.before": async (input, output) => {
    const args = output && output.args
    const command = args && args.command

    if (typeof command !== "string" || command === "") {
      if (SHELL_TOOLS.has(input && input.tool)) {
        throw new Error(
          `faramir: ${input.tool} was called with no command string, so this ` +
            "plugin could not guard it and the call was not made",
        )
      }
      // Every other tool: nothing here runs a command, so there is no output
      // worth redacting and nothing to decide.
      return
    }

    const result = spawnSync(CLI, ["guard", "--host", HOST], {
      input: JSON.stringify({ tool_name: input.tool, tool_input: args }),
      encoding: "utf8",
      timeout: 10000,
    })

    // Fail closed: running the command without a decision would print
    // whatever it found straight into the transcript.
    //
    // On the exit status alone. A child that never started has none, so null
    // covers a guard that is not there, one killed by the timeout above and one
    // killed by a signal. `result.error` does not mean the same thing: it is
    // also set when this end's write to the guard's stdin does not finish, which
    // a guard that answers without draining its payload causes on a run that
    // worked. What it says instead is why, where there is a why to give.
    if (result.status !== 0) {
      throw new Error(
        `faramir: the guard did not answer, so this command was not run (${CLI} guard --host ${HOST})` +
          whyNot(result),
      )
    }

    // Nothing to say: a backgrounded command, or one already under the
    // redactor. See docs/design.md.
    const text = (result.stdout || "").trim()
    if (!text) return

    let decision
    try {
      decision = JSON.parse(text)
    } catch {
      throw new Error("faramir: the guard's answer was not JSON, so this command was not run")
    }

    switch (decision.decision) {
      case "deny":
        // Reaches the model, not the operator, and names the tool to use
        // instead.
        throw new Error(decision.reason)
      case "rewrite": {
        // Held to carrying a command before anything is assigned. Object.assign
        // ignores null and undefined, and takes index properties off a string, so
        // a rewrite that arrives without a usable tool_input would leave the
        // command as the model wrote it and this hook would return having changed
        // nothing: the one answer that runs unredacted rather than failing closed.
        const rewritten = decision.tool_input
        if (!rewritten || typeof rewritten !== "object" || typeof rewritten.command !== "string") {
          throw new Error(
            "faramir: the guard asked for a rewrite and named no command to run " +
              "instead, so this command was not run",
          )
        }
        // Assigned into the object the host handed in, which is how this hook
        // changes a call. Every field, not only the command.
        Object.assign(args, rewritten)
        return
      }
      default:
        throw new Error(
          "faramir: the guard returned a decision this plugin does not understand, " +
            "so this command was not run",
        )
    }
  },
})
{{if .DefaultExport}}
export default { id: "faramir", server: faramir }
{{end}}
