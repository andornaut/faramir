[Unit]
Description=faramir keeper: holds the age key, serves decrypted values
Documentation=file:///usr/local/share/doc/faramir/README.md
Requires=faramir-keeper.socket
After=faramir-keeper.socket

[Service]
Type=notify
NotifyAccess=main
User=faramir-keeper
Group=faramir-keeper
ExecStart=/usr/local/bin/faramir-keeper
Restart=on-failure
RestartSec=2

# dev, and only for this: the managed sops files are in /etc/faramir/secrets,
# which is 2770 root:dev, and sops has to read them to decrypt anything.  It is
# read access to encrypted files -- the key stays 0400 faramir-keeper, and no
# dev member gains anything from this process being in the group.
SupplementaryGroups=dev

# The whole point of this unit.  The key is readable at
# $CREDENTIALS_DIRECTORY/age_key by this process and by nothing else: the file
# is 0400 faramir-keeper, and no command the broker runs shares this uid.
LoadCredential=age_key:/etc/faramir/age.key

# This process execs sops and nothing else.  It never runs a brokered
# command, never touches a PTY, and never talks to the network, so it can be
# locked down considerably harder than the broker.
PrivateNetwork=true
RestrictAddressFamilies=AF_UNIX
ProtectProc=invisible
ProcSubset=pid
NoNewPrivileges=true
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
# This is the uid that holds the age key, which makes it the one worth taking
# /home away from outright rather than leaving it visible and read-only.
#
# A store kept in a home needs this relaxed, and the installer writes that
# drop-in when CONFIG_DIR is inside one: ProtectHome=tmpfs, plus a
# BindReadOnlyPaths= naming only that directory, so the other homes stay hidden.
# Note what a home costs either way: it is not mounted until its owner logs in,
# so the store is absent at boot.  The broker treats an absent store as a load
# failure rather than an empty one, which turns that into a refusal instead of a
# session that silently redacts nothing.
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
# Somewhere for sops to put ~/.config; it writes nothing that outlives a run.
StateDirectory=faramir-keeper
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources @mount @debug @cpu-emulation @obsolete
SystemCallArchitectures=native
SystemCallErrorNumber=EPERM
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
ProtectClock=true
ProtectControlGroups=true
ProtectHostname=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
RemoveIPC=true
UMask=0077

# The managed sops files must be readable here.  Under ProtectSystem=strict the
# whole hierarchy is read-only but visible, so /etc/faramir/secrets is readable
# subject to its own mode, which is 2770 root:dev with this uid in dev.

[Install]
WantedBy=multi-user.target
