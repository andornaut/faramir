[Unit]
Description=faramir keeper: holds the age key, serves decrypted values
Documentation=file:///usr/local/share/doc/faramir/README.md
Requires=faramir-keeper.socket
After=faramir-keeper.socket

[Service]
Type=notify
NotifyAccess=main
User=faramir-keeper
Group=faramir-keeper
ExecStart=/usr/local/bin/faramir-keeper
Restart=on-failure
RestartSec=2

# devwork, and only for this: the sops files live in the agent's working tree,
# which is group devwork, and sops has to read them to decrypt anything.  It is
# read access to encrypted files -- the key stays 0400 faramir-keeper, and no
# devwork member gains anything from this process being in the group.
SupplementaryGroups=devwork

# The whole point of this unit.  The key is readable at
# $CREDENTIALS_DIRECTORY/age_key by this process and by nothing else: the file
# is 0400 faramir-keeper, and no command the broker runs shares this uid.
LoadCredential=age_key:/etc/faramir/age.key

# This process execs sops and nothing else.  It never runs an allowlisted
# command, never touches a PTY, and never talks to the network, so it can be
# locked down considerably harder than the broker.
PrivateNetwork=true
RestrictAddressFamilies=AF_UNIX
ProtectProc=invisible
ProcSubset=pid
NoNewPrivileges=true
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
# tmpfs, not true: the sops files live in the working tree, usually under
# /home, and this is the only process that decrypts them.  Read-only -- the
# keeper never writes the tree.  install/20-install-broker.sh writes
# faramir-keeper.service.d/10-worktree.conf with the configured tree.
ProtectHome=tmpfs
BindReadOnlyPaths=-/home/agent/work/repo
PrivateTmp=true
PrivateDevices=true
# Somewhere for sops to put ~/.config; it writes nothing that outlives a run.
StateDirectory=faramir-keeper
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources @mount @debug @cpu-emulation @obsolete
SystemCallArchitectures=native
SystemCallErrorNumber=EPERM
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
ProtectClock=true
ProtectControlGroups=true
ProtectHostname=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
RemoveIPC=true
UMask=0077

# The managed sops files must be readable here.  Under ProtectSystem=strict the
# whole tree is read-only but visible, so a [secrets] file outside /home works
# with no drop-in at all; one under /home needs the bind mount above to name
# the tree it is in, which is what the installer writes.

[Install]
WantedBy=multi-user.target
