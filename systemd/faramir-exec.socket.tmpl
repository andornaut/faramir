[Unit]
Description=faramir executor socket
Documentation=file:///usr/local/share/doc/faramir/README.md
# Socket activated and restarted by an install, so repeated starts are ordinary.
# The default limit reads that as a crash loop and latches the unit into failed,
# where `systemctl start` will not bring it back and only `reset-failed` does.
StartLimitIntervalSec=0

[Socket]
ListenStream={{.RunDir}}/exec.sock
# root-owned so the executor's own uid cannot connect: a child that could reach
# this socket could run commands the broker never authorised or logged.
SocketMode=0660
SocketUser=root
SocketGroup={{.BrokerGroup}}
Accept=no

[Install]
WantedBy=sockets.target
