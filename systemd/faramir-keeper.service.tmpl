[Unit]
Description=faramir keeper: holds the age key, serves decrypted values
Documentation=file://{{.DocDir}}/README.md
Requires=faramir-keeper.socket
After=faramir-keeper.socket
# Socket activated and restarted by an install, so repeated starts are ordinary.
# The default limit reads that as a crash loop and fails the socket with it.
StartLimitIntervalSec=0

[Service]
Type=notify
NotifyAccess=main
User={{.KeeperUser}}
Group={{.KeeperUser}}
ExecStart={{.BinDir}}/faramir keeper
SyslogIdentifier=faramir-keeper
Environment=FARAMIR_CONFIG={{.ConfigFile}}
Restart=on-failure
RestartSec=2

# {{.SecretsGroup}}, only so this process can read {{.SecretsDir}} (2750, that
# group) to decrypt and fingerprint.  Read access to ciphertext; the key stays
# 0400 {{.KeeperUser}}.  Redundant when the secrets group is this account's own,
# which is the default, but --secrets-group can name a different one.
SupplementaryGroups={{.SecretsGroup}}

# The key is readable at $CREDENTIALS_DIRECTORY/age_key by this process alone;
# no command the broker runs shares this uid.  The name is what [keeper]
# age_key_credential refers to.
LoadCredential=age_key:{{.AgeKeyPath}}

# This process execs sops and nothing else: no brokered command, no PTY, no
# network, so it locks down harder than the broker.
PrivateNetwork=true
RestrictAddressFamilies=AF_UNIX
ProtectProc=invisible
ProcSubset=pid
NoNewPrivileges=true
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
# The uid that holds the age key, so /home goes away outright.
{{if .KeeperBinds -}}
# The config directory is inside a home, so tmpfs rather than true: every other
# home stays invisible and only that directory is bound back.  A home is not
# mounted until its owner logs in, so the secrets are absent at boot, which the
# broker treats as a load failure rather than an empty one.
ProtectHome=tmpfs
{{range .KeeperBinds}}BindReadOnlyPaths={{.}}
{{end -}}
{{- else -}}
ProtectHome=true
{{- end}}
PrivateTmp=true
PrivateDevices=true
# Somewhere for sops to put ~/.config.
StateDirectory={{.KeeperUser}}
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources @mount @debug @cpu-emulation @obsolete
SystemCallArchitectures=native
SystemCallErrorNumber=EPERM
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
ProtectClock=true
ProtectControlGroups=true
ProtectHostname=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
RemoveIPC=true
UMask=0077

# Under ProtectSystem=strict the hierarchy is read-only but visible, so
# {{.SecretsDir}} is readable subject to its own mode: 2750, group
# {{.SecretsGroup}}, this uid in it.

[Install]
WantedBy=multi-user.target
