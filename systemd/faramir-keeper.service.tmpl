[Unit]
Description=faramir keeper: holds the age key, serves decrypted values
Documentation=file://{{.DocDir}}/README.md
Requires=faramir-keeper.socket
After=faramir-keeper.socket
# Starting repeatedly in a few seconds is ordinary here: the unit is socket
# activated and an install restarts it.  The default limit of 5 in 10s reads
# that as a crash loop, and a service that trips it fails its socket with it, so
# the whole broker stays down until someone runs reset-failed.
StartLimitIntervalSec=0

[Service]
Type=notify
NotifyAccess=main
User={{.KeeperUser}}
Group={{.KeeperUser}}
ExecStart={{.BinDir}}/faramir-keeper
Environment=FARAMIR_CONFIG={{.ConfigFile}}
Restart=on-failure
RestartSec=2

# {{.Group}}, and only for this: the managed sops files are in {{.SecretsDir}},
# which is 2770 with that group, and sops has to read them to decrypt anything.
# It is read access to encrypted files -- the key stays 0400 {{.KeeperUser}}, and
# no member of the group gains anything from this process being in it.
SupplementaryGroups={{.Group}}

# The whole point of this unit.  The key is readable at
# $CREDENTIALS_DIRECTORY/age_key by this process and by nothing else: the file
# is 0400 {{.KeeperUser}}, and no command the broker runs shares this uid.
#
# Either source presents it under the same name, which is what [keeper]
# age_key_credential in the config refers to, so the keeper never learns which
# one it came from.
{{if .SealAgeKey -}}
# Sealed to this host's TPM.  The plaintext path is not read at all: two entries
# claiming one credential name is a unit systemd refuses to start.
LoadCredentialEncrypted=age_key:{{.AgeKeyCred}}
{{- else -}}
LoadCredential=age_key:{{.AgeKeyPath}}
{{- end}}

# This process execs sops and nothing else.  It never runs a brokered
# command, never touches a PTY, and never talks to the network, so it can be
# locked down considerably harder than the broker.
PrivateNetwork=true
RestrictAddressFamilies=AF_UNIX
ProtectProc=invisible
ProcSubset=pid
NoNewPrivileges=true
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
# This is the uid that holds the age key, which makes it the one worth taking
# /home away from outright rather than leaving it visible and read-only.
{{if .KeeperBinds -}}
# The config or the store is inside a home, so tmpfs rather than true: every
# other home stays invisible to the process holding the age key, and only what
# it reads is bound back in.  Note what a home costs either way: it is not
# mounted until its owner logs in, so the store is absent at boot.  The broker
# treats an absent store as a load failure rather than an empty one, which turns
# that into a refusal instead of a session that silently redacts nothing.
ProtectHome=tmpfs
{{range .KeeperBinds}}BindReadOnlyPaths={{.}}
{{end -}}
{{- else -}}
ProtectHome=true
{{- end}}
PrivateTmp=true
PrivateDevices=true
# Somewhere for sops to put ~/.config; it writes nothing that outlives a run.
StateDirectory={{.KeeperUser}}
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources @mount @debug @cpu-emulation @obsolete
SystemCallArchitectures=native
SystemCallErrorNumber=EPERM
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
ProtectClock=true
ProtectControlGroups=true
ProtectHostname=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
RemoveIPC=true
UMask=0077

# The managed sops files must be readable here.  Under ProtectSystem=strict the
# whole hierarchy is read-only but visible, so {{.SecretsDir}} is readable
# subject to its own mode, which is 2770 with group {{.Group}} and this uid in it.

[Install]
WantedBy=multi-user.target
