[Unit]
Description=Secret broker socket
Documentation=file:///usr/local/share/doc/faramir/README.md
# Socket activated and restarted by an install, so repeated starts are ordinary.
# The default limit reads that as a crash loop and latches the unit into failed,
# where `systemctl start` will not bring it back and only `reset-failed` does.
StartLimitIntervalSec=0

[Socket]
ListenStream={{.RunDir}}/broker.sock
SocketMode=0660
SocketUser=root
SocketGroup={{.ClientGroup}}
# One service instance handles every connection; it holds the decrypted value
# set in memory, so per-connection forking would mean re-decrypting each time.
Accept=no

[Install]
WantedBy=sockets.target
