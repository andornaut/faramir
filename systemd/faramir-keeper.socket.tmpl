[Unit]
Description=faramir keeper socket
Documentation=file:///usr/local/share/doc/faramir/README.md
# Socket activated and restarted by an install, so repeated starts are ordinary.
# The default limit reads that as a crash loop and latches the unit into failed,
# where `systemctl start` will not bring it back and only `reset-failed` does.
StartLimitIntervalSec=0

[Socket]
ListenStream={{.RunDir}}/keeper.sock
# Reachable only by the broker: {{.ExecUser}}, which every brokered command runs
# as, is in neither the owner nor the group here.
SocketMode=0660
SocketUser=root
SocketGroup={{.BrokerGroup}}
Accept=no

[Install]
WantedBy=sockets.target
