[Unit]
Description=faramir keeper socket
Documentation=file:///usr/local/share/doc/faramir/README.md

[Socket]
ListenStream={{.RunDir}}/keeper.sock
# Reachable only by the broker: {{.ExecUser}}, which every brokered command runs
# as, is in neither the owner nor the group here.
SocketMode=0660
SocketUser=root
SocketGroup={{.BrokerUser}}
Accept=no

[Install]
WantedBy=sockets.target
