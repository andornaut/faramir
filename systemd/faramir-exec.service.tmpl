[Unit]
Description=faramir executor: forks brokered commands, holds no secrets
Documentation=file://{{.DocDir}}/README.md
Requires=faramir-exec.socket
After=faramir-exec.socket network.target
# Socket activated and restarted by an install, so repeated starts are ordinary.
# The default limit reads that as a crash loop and fails the socket with it.
StartLimitIntervalSec=0

[Service]
Type=notify
NotifyAccess=main
User={{.ExecUser}}
Group={{.ExecUser}}
ExecStart={{.BinDir}}/faramir exec
SyslogIdentifier=faramir-exec
Environment=FARAMIR_CONFIG={{.ConfigFile}}
Restart=on-failure
RestartSec=2

# {{.ClientGroup}}, because brokered commands run in the working tree and write to it:
# ansible drops .retry files and fact caches.  The tree is agent-owned and
# group-writable, so this is the access the agent already has.
SupplementaryGroups={{.ClientGroup}}

# Every brokered command runs as this uid, so what it can reach is what a
# command can reach:
#
#   {{.AgeKeyPath}}      no  (0400 {{.KeeperUser}})
#   {{.RunDir}}/keeper.sock  no  (0660 root:{{.BrokerUser}})
#   {{.RunDir}}/exec.sock    no  (0660 root:{{.BrokerUser}})
#   {{.LogDir}}/audit.log  no  (0600 {{.BrokerUser}})
#   ~{{.BrokerUser}}/.ssh      no  (0700 {{.BrokerUser}})
#   the working tree          read and write, via {{.ClientGroup}} above
#   the rest of /home         whatever the mode allows, read-only
#
# {{.RunDir}}/broker.sock is reachable, being 0660 root:{{.ClientGroup}}, so a brokered
# command can call the broker back.  That buys it nothing: the response is
# redacted and audited like the agent's own.
#
# No LoadCredential=, and nothing writable but the working tree, this account's
# state directory and PrivateTmp.
ProtectProc=invisible
ProcSubset=pid
NoNewPrivileges=true
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
# ProtectSystem=strict makes the hierarchy read-only, so every writable place
# has to be named.  A whole tree rather than one directory: a command runs where
# its caller was, and no config names that.
#
# Lifting the read-only mount grants nothing on its own; modes still decide, and
# homes are 0700.  The leading "-" lets /home be absent.  A working tree outside
# it needs a drop-in adding its path.
ReadWritePaths=-/home
PrivateTmp=true
# Children run on a PTY, so the device ACL is narrowed rather than dropped.
PrivateDevices=false
DevicePolicy=closed
DeviceAllow=/dev/ptmx rw
DeviceAllow=char-pts rw
# Ansible creates ~/.ansible/tmp unconditionally; this is that home.
StateDirectory={{.ExecUser}}
# No RuntimeDirectory=faramir: it would recursively chown the activation sockets
# to this uid.  {{.RunDir}} comes from /etc/tmpfiles.d/faramir.conf and stays
# read-only here; connecting to a socket is not a write.
# Ansible reaches managed hosts over SSH, so the network stays.
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
SystemCallFilter=@system-service
SystemCallArchitectures=native
SystemCallErrorNumber=EPERM
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
ProtectClock=true
ProtectControlGroups=true
ProtectHostname=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
RemoveIPC=true
# 0007 rather than the other two's 0077: children write into the operator's
# working tree, and a file the operator cannot open is not a shared tree.  With
# the setgid directory supplying the group, their files land 0660
# {{.ExecUser}}:{{.ClientGroup}}.  The executor itself creates no files.
UMask=0007

# Every remaining exposure item, and why it is accepted.  Anything flagged that
# is NOT on this list is a regression.
#
#   PrivateNetwork=, IPAddressDeny=
#       Brokered commands reach managed hosts; egress control is a non-goal.
#   MemoryDenyWriteExecute=
#       Children are arbitrary operator-chosen programs, some of them JITs.
#   SystemCallFilter=~@privileged, ~@resources
#       Ansible's file and user modules call chown and friends.
#   PrivateDevices=, DeviceAllow=
#       Every child runs on a PTY.
#   SupplementaryGroups=, ReadWritePaths=
#       Commands run in the working tree and write to it.

[Install]
WantedBy=multi-user.target
