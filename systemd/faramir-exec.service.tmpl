[Unit]
Description=faramir executor: forks brokered commands, holds no secrets
Documentation=file://{{.DocDir}}/README.md
Requires=faramir-exec.socket
After=faramir-exec.socket network.target

[Service]
Type=notify
NotifyAccess=main
User={{.ExecUser}}
Group={{.ExecUser}}
ExecStart={{.BinDir}}/faramir-exec
Environment=FARAMIR_CONFIG={{.ConfigFile}}
Restart=on-failure
RestartSec=2

# {{.Group}}, because brokered commands run *in* the working tree and write to it:
# ansible drops .retry files and fact caches, and a playbook that generates
# config has to be able to put it somewhere.  The tree is agent-owned and
# group-writable, so this is the same access the agent already has -- it is not
# a way into anything the agent could not reach itself.
SupplementaryGroups={{.Group}}

# This uid is the one every brokered command runs as, so the list of things it
# can reach is the list of things a command can reach:
#
#   {{.AgeKeyPath}}      no  (0400 {{.KeeperUser}})
#   {{.RunDir}}/keeper.sock  no  (0660 root:{{.BrokerUser}})
#   {{.RunDir}}/exec.sock    no  (0660 root:{{.BrokerUser}})
#   {{.LogDir}}/audit.log  no  (0600 {{.BrokerUser}})
#   ~{{.BrokerUser}}/.ssh      no  (0700 {{.BrokerUser}})
#   the working tree          read and write, via {{.Group}} above
#   the rest of /home         whatever the mode allows, which for a 0700 home
#                             is nothing; read-only regardless, and the one
#                             writable path below is the agent's own home
#
# {{.RunDir}}/broker.sock IS reachable now, because it is 0660 root:{{.Group}}:
# a brokered command can call the broker back.  That buys it nothing -- the
# response is redacted and audited exactly like the agent's own,
# and every ref it could ask for is already listed by faramir_list_secrets.
#
# No LoadCredential=, and nothing writable except the working tree, its own
# state directory and PrivateTmp.
ProtectProc=invisible
ProcSubset=pid
NoNewPrivileges=true
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
# ProtectSystem=strict makes the whole hierarchy read-only, so every place a
# brokered command may write has to be named.  Whole trees rather than one
# directory: a command runs where its caller was, and no config names that, so
# there is no single path to grant.
#
# /home, because a caller works in a checkout there.  Naming nothing leaves the
# tree read-only, and a playbook writing a .retry file or a fact cache fails with
# EROFS rather than anything that names the mount.
#
# The leading "-" is what lets it be absent.  It grants nothing on its own:
# lifting the read-only mount is not permission, and modes still decide.  Homes
# are 0700, so the only thing writable under /home is a tree `faramir share-tree`
# group-writes on purpose.
#
# A working tree outside /home needs a drop-in adding its path.
ReadWritePaths=-/home
PrivateTmp=true
# Children run on a PTY, which needs /dev/ptmx and the pts devices.  Narrow the
# device ACL rather than dropping it.
PrivateDevices=false
DevicePolicy=closed
DeviceAllow=/dev/ptmx rw
DeviceAllow=char-pts rw
# Ansible creates ~/.ansible/tmp unconditionally; this is that home.
StateDirectory={{.ExecUser}}
# No RuntimeDirectory=faramir: it would recursively chown the activation
# sockets to this uid (see faramir-broker.service).  {{.RunDir}} comes from
# /etc/tmpfiles.d/faramir.conf and stays read-only here; connecting to a socket
# is not a write the read-only mount can refuse, and the directory's own mode
# is what keeps this uid from unlinking anything in it.
# Ansible reaches managed hosts over SSH, so the network stays.
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
SystemCallFilter=@system-service
SystemCallArchitectures=native
SystemCallErrorNumber=EPERM
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
ProtectClock=true
ProtectControlGroups=true
ProtectHostname=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
RemoveIPC=true
UMask=0077

# Every remaining exposure item, and why it is accepted:
#
#   PrivateNetwork=, IPAddressDeny=
#       Brokered commands reach managed hosts.  Egress control is a non-goal;
#       see "What it protects against" in the README.
#   MemoryDenyWriteExecute=
#       Children are arbitrary operator-chosen programs, some of them JITs.
#   SystemCallFilter=~@privileged, ~@resources
#       Ansible's file and user modules call chown and friends.
#   PrivateDevices=, DeviceAllow=
#       Every child runs on a PTY.
#   SupplementaryGroups=, ReadWritePaths=
#       Commands run in the working tree and write to it.  See above: this is
#       the agent's own access, not a new one.
#
# Anything flagged that is NOT on this list is a regression: investigate it
# before accepting it.

[Install]
WantedBy=multi-user.target
