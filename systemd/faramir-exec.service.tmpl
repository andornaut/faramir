[Unit]
Description=faramir executor: forks brokered commands, holds no secrets
Documentation=file://{{.DocDir}}/README.md
Requires=faramir-exec.socket
After=faramir-exec.socket network.target
# Socket activated and restarted by an install, so repeated starts are ordinary.
# The default limit reads that as a crash loop and latches this unit into
# failed.  The socket unit carries the same directive, for the same reason.
StartLimitIntervalSec=0

[Service]
Type=notify
NotifyAccess=main
User={{.ExecUser}}
# The account's own group, resolved rather than assumed to share its name: an
# adopted account's primary group need not be called what the account is.
Group={{.ExecGroup}}
ExecStart={{.BinDir}}/faramir exec
SyslogIdentifier=faramir-exec
Environment=FARAMIR_CONFIG={{.ConfigFile}}
Restart=on-failure
RestartSec=2
# KillMode is systemd's default control-group, so a stop ends every brokered
# command in this unit's tree along with the daemon.  Named rather than
# inherited, and the same 30s the broker gets, so one restart does not sit at
# two different limits.
TimeoutStopSec=30

# {{.ClientGroup}}, because brokered commands run in the working tree and write to it:
# ansible drops .retry files and fact caches.  The tree is agent-owned and
# group-writable, so this is the access the agent already has.
SupplementaryGroups={{.ClientGroup}}

# Every brokered command runs as this uid, so what it can reach is what a
# command can reach:
#
#   {{.AgeKeyPath}}      no  (0400 {{.KeeperUser}})
#   {{.RunDir}}/keeper.sock  no  (0660 root:{{.BrokerUser}})
#   {{.RunDir}}/exec.sock    no  (0660 root:{{.BrokerUser}})
#   {{.LogDir}}/audit.log  no  (0600 {{.BrokerUser}})
#   ~{{.BrokerUser}}/.ssh      no  (0700 {{.BrokerUser}})
#   the working tree          read and write, via {{.ClientGroup}} above
#   the rest of /home         whatever the mode allows, read-only
#
# {{.RunDir}}/broker.sock is reachable, being 0660 root:{{.ClientGroup}}, so a brokered
# command can call the broker back.  That gains it nothing: the response is
# redacted and audited like the agent's own.
#
# No LoadCredential=, and nothing writable but the working tree, this account's
# state directory and PrivateTmp.
# ProcSubset=pid is deliberately not set alongside this.  It hides every non-pid
# top-level procfs entry, /proc/sys among them, and a command that reads a kernel
# tunable then fails on a file that is merely absent, naming nothing that explains
# why.  ostree opens /proc/sys/kernel/random/boot_id, so flatpak cannot run at all
# under it.  The broker and keeper units, which run no arbitrary command, keep it.
ProtectProc=invisible
{{if .AllowSudo}}
# This host was installed with `faramir init --allow-sudo`, so the directives that
# bound *root* are dropped here.  Not a weakening thrown in with the grant: each
# one below would otherwise make the grant ineffective, either refusing sudo
# outright or handing back a root that cannot change anything.  What bounds this
# uid when nobody has approved anything is unchanged: the uid.
#
# The two halves are separate on purpose.  Everything in this block is about
# what an *approved* command may do; everything outside it is about what
# {{.ExecUser}} may do unasked, and none of that moved.
#
# NoNewPrivileges=true makes every setuid binary inert, sudo included, so a host
# with it set and a sudoers entry written reports "effective uid is not 0" on
# every task and nothing says why.
NoNewPrivileges=false
# CapabilityBoundingSet= is not set: an empty one bounds root as well, so an
# approval would reach uid 0 holding no capability and fail on the
# first chown, mount or bind.  AmbientCapabilities= stays empty, which grants
# this uid nothing before sudo has run.
AmbientCapabilities=
# ProtectSystem= is not set either.  A read-only /usr and /etc is exactly what
# an approved "configure this host" is for, so leaving it on would turn every
# such task into EROFS.  Below the approval, file modes are what refuse this
# uid, as they do everywhere else.
#
# ReadWritePaths= is then unnecessary: nothing is mounted read-only to name an
# exception to.
PrivateTmp=true
# Children run on a PTY.  The device ACL is dropped rather than narrowed: an
# approved root task that touches a disk or a tty other than its own is one the
# human said yes to.
PrivateDevices=false
# Ansible creates ~/.ansible/tmp unconditionally; this is that home.
StateDirectory={{.ExecUser}}
#
# EVERY seccomp-based directive is absent here, and that is not a preference.
# systemd turns NoNewPrivileges= ON, overriding the line above, if any of
# LockPersonality=, MemoryDenyWriteExecute=, PrivateDevices=true,
# ProtectClock=, ProtectHostname=, ProtectKernelLogs=, ProtectKernelModules=,
# ProtectKernelTunables=, RestrictAddressFamilies=, RestrictNamespaces=,
# RestrictRealtime=, RestrictSUIDSGID=, SystemCallArchitectures= or
# SystemCallFilter= is set.  A seccomp filter without CAP_SYS_ADMIN requires
# NNP, so the two cannot both hold; and with NNP on, sudo is inert and this
# host's grant reports "effective uid is not 0" on every task.
#
# So keeping one of them here does not harden this unit.  It silently turns the
# feature off.  faramir-exec.service on a host without --allow-sudo keeps all of
# them, which is the arrangement to prefer.
#
# What is left below is what bounds this uid without seccomp: a namespace, a
# home, an IPC sweep and a umask.  ProtectProc= above is a procfs mount option
# rather than a filter, so it stays either way.
RemoveIPC=true
{{else}}
NoNewPrivileges=true
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
# ProtectSystem=strict makes the hierarchy read-only, so every writable place
# has to be named.  A whole tree rather than one directory: a command runs where
# its caller was, and no config names that.
#
# Lifting the read-only mount grants nothing on its own; modes still decide, and
# homes are 0700.  The leading "-" lets /home be absent.  A working tree outside
# it needs a drop-in adding its path.
ReadWritePaths=-/home
PrivateTmp=true
# Children run on a PTY, so the device ACL is narrowed rather than dropped.
PrivateDevices=false
DevicePolicy=closed
DeviceAllow=/dev/ptmx rw
DeviceAllow=char-pts rw
# Ansible creates ~/.ansible/tmp unconditionally; this is that home.
StateDirectory={{.ExecUser}}
# No RuntimeDirectory=faramir: it would recursively chown the activation sockets
# to this uid.  {{.RunDir}} comes from /etc/tmpfiles.d/faramir.conf and stays
# read-only here; connecting to a socket is not a write.
# Ansible reaches managed hosts over SSH, so the network stays.
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
SystemCallFilter=@system-service
SystemCallArchitectures=native
SystemCallErrorNumber=EPERM
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
ProtectClock=true
# ProtectControlGroups= is NOT set, unlike the rest of the Protect* family: the
# executor confines each run to a cgroup of its own (Delegate= below) and reaps
# the whole cgroup when the run ends, which it cannot do against a read-only
# cgroupfs.  Delegate= scopes the writable view to this service's own subtree;
# ownership refuses every other cgroup, so the reach gained is one subtree the
# executor created itself.
ProtectHostname=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
RemoveIPC=true
{{end}}
# Every brokered command is confined to a cgroup of its own and the whole cgroup
# is killed when the run ends, so a child that calls setsid, escaping a
# process-group kill, is reaped all the same.  Delegate= is what hands this
# service the cgroup subtree it makes those under; without it the executor cannot
# confine and refuses to run.  On both branches, a sudo grant or not: it is the one
# mechanism that ends a run's processes, and `faramir doctor` checks it.
Delegate=yes
# 0007 rather than the other two's 0077: children write into the operator's
# working tree, and a file the operator cannot open is not a shared tree.  With
# the setgid directory supplying the group, their files land 0660
# {{.ExecUser}}:{{.ClientGroup}}.  The executor itself creates no files.
UMask=0007

# Every remaining exposure item, and why it is accepted.  Anything flagged that
# is NOT on this list is a regression.  On a host installed with --allow-sudo the
# block above adds its own, each stated there.
#
#   PrivateNetwork=, IPAddressDeny=
#       Brokered commands reach managed hosts; egress control is a non-goal.
#   MemoryDenyWriteExecute=
#       Children are arbitrary operator-chosen programs, some of them JITs.
#   SystemCallFilter=~@privileged, ~@resources
#       Ansible's file and user modules call chown and friends.
#   RestrictNamespaces=
#       It is a seccomp rule on clone()'s flags argument, and clone3() carries the
#       same flags behind a pointer seccomp cannot read, so systemd denies clone3()
#       with ENOSYS wherever this is set at all: glibc's fork() then retries with
#       clone().  Every run is spawned with CLONE_INTO_CGROUP, which only clone3()
#       has and which has no such retry, so setting this to any value stops the
#       executor spawning anything.  Losing it hands a child a full capability set
#       inside a user namespace it creates; hosts that care set
#       kernel.apparmor_restrict_unprivileged_userns.
#   PrivateDevices=, DeviceAllow=
#       Every child runs on a PTY.
#   SupplementaryGroups=, ReadWritePaths=
#       Commands run in the working tree and write to it.
#   ProtectControlGroups=
#       The executor manages a per-run cgroup; Delegate= scopes that to its own
#       subtree and ownership refuses the rest.

[Install]
WantedBy=multi-user.target
