[Unit]
Description=Secret broker for local AI agents
Documentation=file:///usr/local/share/doc/faramir/README.md
Requires=faramir-broker.socket faramir-keeper.socket faramir-exec.socket
After=faramir-broker.socket faramir-keeper.socket faramir-exec.socket network.target

[Service]
Type=notify
NotifyAccess=main
User=faramir-broker
Group=faramir-broker
# devwork: read access to the shared working tree, which is where the sops
# files live -- the broker stats them to notice edits.
# faramir-exec: needed only to hand the ssh-agent socket to the executor's uid,
# which is a chown this process could not otherwise perform.  It grants the
# broker nothing it did not already have; the executor gains nothing at all.
SupplementaryGroups=devwork faramir-exec
ExecStart=/usr/local/bin/faramir-broker
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=2

# No LoadCredential= here, deliberately.  A systemd credential is readable by
# the unit's uid, and every brokered command runs as that uid, so loading the
# age key here would hand it to every child, whatever else the config said.
# faramir-keeper.service holds it instead and serves values only.

# The critical one: without ProtectProc the agent uid can read
# /proc/<pid>/environ of the broker and of every command it runs.
ProtectProc=invisible
ProcSubset=pid

NoNewPrivileges=true
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
# No ProtectHome=: the broker only reads the sops files in the working tree,
# and ProtectSystem=strict already mounts the whole hierarchy read-only.  There
# was a tmpfs over /home with one bind mount punched through it, which meant the
# tree's path had to be repeated in a drop-in here and kept in step with the
# config.  What it bought over file modes was nothing: a home this uid may not
# read is one the mode already refuses, and a home it may read is one the agent
# uid can read directly without going through the broker at all.
PrivateTmp=true
# PrivateDevices would hide /dev/ptmx, and the broker allocates a PTY for every
# child (see docs/redaction.md).  Narrow the device ACL instead of dropping it.
PrivateDevices=false
DevicePolicy=closed
DeviceAllow=/dev/ptmx rw
DeviceAllow=char-pts rw
ReadWritePaths=/var/log/faramir
RuntimeDirectory=faramir
# /run/faramir holds the keeper's socket as well as this one; without this,
# stopping the broker removes the directory and takes keeper.sock with it.
RuntimeDirectoryPreserve=yes
# The broker's home: SSH keys for managed hosts, and ~/.ansible/tmp, which
# ansible-playbook creates unconditionally.  It lives here rather than under
# /home because a service account's state belongs there, not in /home.
StateDirectory=faramir-broker
LogsDirectory=faramir
# AF_INET/AF_INET6/AF_NETLINK are required: the broker runs Ansible over SSH.
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
SystemCallFilter=@system-service
SystemCallArchitectures=native
SystemCallErrorNumber=EPERM
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=false
ProtectClock=true
ProtectControlGroups=true
ProtectHostname=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
RemoveIPC=true
# 0077: this process no longer creates files anything else has to read.  The
# working tree is written by the agent and by the executor, each under its own
# umask; the audit log sets an explicit 0600 in internal/audit rather than on
# this.
UMask=0077

# systemd-analyze security faramir-broker.service -> 1.7 OK (systemd 255)
#
# Every remaining exposure item, and why it is accepted:
#
#   PrivateNetwork=, IPAddressDeny=, RestrictAddressFamilies=~AF_(INET|INET6),
#   RestrictAddressFamilies=~AF_NETLINK
#       The broker runs Ansible over SSH, so it needs the network and name
#       resolution.  Egress control is an explicit non-goal of this project.
#   PrivateDevices=, DeviceAllow=
#       Every child runs on a PTY, which needs /dev/ptmx and char-pts.  The
#       device ACL is narrowed to exactly those rather than left open.
#   RestrictAddressFamilies=~AF_UNIX
#       That is the broker's own listening socket.
#   SupplementaryGroups=
#       devwork, so the broker can stat the sops files in the working tree.
#   ProtectHome=
#       Removed.  It hid other users' homes from a process that file modes
#       already keep out of them, and cost a bind mount whose path had to agree
#       with the config.  See "Architecture" in the README.
#   SystemCallFilter=~@privileged, ~@resources
#       Both are inside @system-service.  Ansible's file/user modules call
#       chown and friends; dropping these breaks ordinary playbooks.
#   PrivateUsers=
#       Would map every other uid to nobody, including the agent uid that owns
#       the working tree.
#   MemoryDenyWriteExecute=
#       Children are arbitrary operator-chosen programs; a broker that refuses to
#       run the operator's tooling gets switched off, which is worse.
#   RootDirectory=/RootImage=
#       Containers were considered and rejected -- see "Architecture" in the
#       README.
#
# Anything flagged here that is NOT on this list is a regression: investigate
# it before accepting it.

[Install]
WantedBy=multi-user.target
