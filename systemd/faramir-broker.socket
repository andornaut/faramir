[Unit]
Description=Secret broker socket
Documentation=file:///usr/local/share/doc/faramir/README.md

[Socket]
ListenStream=/run/faramir/broker.sock
SocketMode=0660
SocketUser=root
SocketGroup=devwork
# One service instance handles every connection; it holds the decrypted value
# set in memory, so per-connection forking would mean re-decrypting each time.
Accept=no

[Install]
WantedBy=sockets.target
