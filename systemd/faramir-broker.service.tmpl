[Unit]
Description=Secret broker for local AI agents
Documentation=file://{{.DocDir}}/README.md
Requires=faramir-broker.socket faramir-keeper.socket faramir-exec.socket
After=faramir-broker.socket faramir-keeper.socket faramir-exec.socket network.target
# {{.RunDir}} comes from /etc/tmpfiles.d/faramir.conf, so it has to exist, and
# be owned by this unit's User=, before the mount namespace ReadWritePaths=
# builds is set up.  Without Wants=, a manual start of this unit alone gets the
# directory auto-created root:root as the parent of a ListenStream=, and the
# broker then starts but cannot create ssh-agent.sock in it.
Wants=systemd-tmpfiles-setup.service
After=systemd-tmpfiles-setup.service

[Service]
Type=notify
NotifyAccess=main
User={{.BrokerUser}}
Group={{.BrokerUser}}
# {{.Group}}: read access to the managed sops files -- the broker stats them to
# notice edits.
# {{.ExecUser}}: needed only to hand the ssh-agent socket to the executor's uid,
# which is a chown this process could not otherwise perform.  It grants the
# broker nothing it did not already have; the executor gains nothing at all.
SupplementaryGroups={{.Group}} {{.ExecUser}}
ExecStart={{.BinDir}}/faramir-broker
Environment=FARAMIR_CONFIG={{.ConfigFile}}
Restart=on-failure
RestartSec=2

# No LoadCredential= here, deliberately.  A systemd credential is readable by
# the unit's uid, and every brokered command runs as that uid, so loading the
# age key here would hand it to every child, whatever else the config said.
# faramir-keeper.service holds it instead and serves values only.

# The critical one: without ProtectProc the agent uid can read
# /proc/<pid>/environ of the broker and of every command it runs.
ProtectProc=invisible
ProcSubset=pid

NoNewPrivileges=true
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
# No ProtectHome=, unlike the keeper, and for one specific reason: the broker
# stats a request's cwd before accepting it, and a caller's cwd is usually
# inside a home.  Hiding /home here would turn every such request into "cwd does
# not exist".  It reads no secret from a home either way, since the managed sops
# files are under /etc, and ProtectSystem=strict already mounts the whole
# hierarchy read-only.  What bounds this uid is file modes: a home it may not
# read is one the mode already refuses, and a home it may read is one the
# operator's own uid can read directly without going through the broker.
PrivateTmp=true
# PrivateDevices would hide /dev/ptmx, and the broker allocates a PTY for every
# child (see docs/redaction.md).  Narrow the device ACL instead of dropping it.
PrivateDevices=false
DevicePolicy=closed
DeviceAllow=/dev/ptmx rw
DeviceAllow=char-pts rw
ReadWritePaths={{.LogDir}}
# {{.RunDir}} is created by /etc/tmpfiles.d/faramir.conf, NOT by
# RuntimeDirectory=faramir here.  systemd chowns a RuntimeDirectory recursively
# whenever the directory's owner does not match the unit's User=, and the three
# activation sockets live in that directory: the chown rewrites their
# SocketUser=/SocketGroup= on every start, leaving broker.sock 0660
# {{.BrokerUser}}:{{.BrokerUser}}, which no {{.Group}} member can reach.  Writable
# because the broker creates ssh-agent.sock in it.
#
# Leading "-": with the directory owned by tmpfiles rather than by this unit, an
# absent {{.RunDir}} would otherwise fail the unit with a mount-namespace error
# at startup instead of the broker reporting what is wrong.
ReadWritePaths=-{{.RunDir}}
# The broker's home: SSH keys for managed hosts, and ~/.ansible/tmp, which
# ansible-playbook creates unconditionally.  It lives here rather than under
# /home because a service account's state belongs there, not in /home.
StateDirectory={{.BrokerUser}}
LogsDirectory=faramir
# Two descriptors per relayed ssh-agent connection, and a playbook authenticates
# to as many hosts at once as -f allows; the default 1024 is not much headroom
# once Ansible's own children are counted.
LimitNOFILE=8192
# AF_INET/AF_INET6/AF_NETLINK are required: the broker runs Ansible over SSH.
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
SystemCallFilter=@system-service
SystemCallArchitectures=native
SystemCallErrorNumber=EPERM
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=false
ProtectClock=true
ProtectControlGroups=true
ProtectHostname=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
RemoveIPC=true
# 0077: this process no longer creates files anything else has to read.  The
# working tree is written by the agent and by the executor, each under its own
# umask; the audit log sets an explicit 0600 in internal/audit rather than on
# this.
UMask=0077

# systemd-analyze security faramir-broker.service -> 1.7 OK (systemd 255)
#
# Every remaining exposure item, and why it is accepted:
#
#   PrivateNetwork=, IPAddressDeny=, RestrictAddressFamilies=~AF_(INET|INET6),
#   RestrictAddressFamilies=~AF_NETLINK
#       The broker runs Ansible over SSH, so it needs the network and name
#       resolution.  Egress control is an explicit non-goal of this project.
#   PrivateDevices=, DeviceAllow=
#       Every child runs on a PTY, which needs /dev/ptmx and char-pts.  The
#       device ACL is narrowed to exactly those rather than left open.
#   RestrictAddressFamilies=~AF_UNIX
#       That is the broker's own listening socket.
#   SupplementaryGroups=
#       {{.Group}}, so the broker can stat the managed sops files.
#   ProtectHome=
#       Removed.  It hid other users' homes from a process that file modes
#       already keep out of them, and cost a bind mount whose path had to agree
#       with the config.  See "Architecture" in the README.
#   SystemCallFilter=~@privileged, ~@resources
#       Both are inside @system-service.  Ansible's file/user modules call
#       chown and friends; dropping these breaks ordinary playbooks.
#   PrivateUsers=
#       Would map every other uid to nobody, including the agent uid that owns
#       the working tree.
#   MemoryDenyWriteExecute=
#       Children are arbitrary operator-chosen programs; a broker that refuses to
#       run the operator's tooling gets switched off, which is worse.
#   RootDirectory=/RootImage=
#       Containers were considered and rejected -- see "Architecture" in the
#       README.
#
# Anything flagged here that is NOT on this list is a regression: investigate
# it before accepting it.

[Install]
WantedBy=multi-user.target
