FROM ubuntu:26.04
ENV DEBIAN_FRONTEND=noninteractive
COPY --from=golang:1.27 /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/ca-certificates.crt
RUN sed -i 's|http://|https://|g' /etc/apt/sources.list.d/ubuntu.sources \
    && apt-get -o Acquire::Retries=2 -o Acquire::https::Timeout=20 \
      -o Acquire::https::CaInfo=/etc/ssl/certs/ca-certificates.crt \
      -o APT::Update::Error-Mode=any update \
    && apt-get -o Acquire::Retries=2 -o Acquire::https::Timeout=20 \
      -o Acquire::https::CaInfo=/etc/ssl/certs/ca-certificates.crt install -y --no-install-recommends openssh-server ca-certificates \
    && rm -rf /var/lib/apt/lists/* \
    && mkdir -p /run/sshd \
    && useradd -m -s /bin/bash deploy \
    && mkdir -p /home/deploy/.ssh && chmod 0700 /home/deploy/.ssh \
    && touch /home/deploy/.ssh/authorized_keys \
    && chmod 0600 /home/deploy/.ssh/authorized_keys \
    && chown -R deploy:deploy /home/deploy/.ssh
# A managed host the broker's key is the only way into: no passwords.
RUN sed -i 's/^#*PasswordAuthentication.*/PasswordAuthentication no/' /etc/ssh/sshd_config \
    && sed -i 's/^#*PermitRootLogin.*/PermitRootLogin no/' /etc/ssh/sshd_config
CMD ["/usr/sbin/sshd", "-D", "-e"]
