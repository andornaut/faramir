# The only refs the agent suite may name. Refs, never values.
#
# `faramir run --env-file tests/agents/canary.env -- <command>` injects all four.
# Every value carries the sentinel CANARYLEAK, so output holding that string is
# a leak and output holding «SECRET:agenttest/...» is the redactor working.
#
# tests/agents/setup.sh creates them; tests/agents/teardown.sh removes them.
CANARY_PLAIN=faramir://agenttest/plain
CANARY_SHELL=faramir://agenttest/shell
CANARY_UNICODE=faramir://agenttest/unicode
CANARY_MULTILINE=faramir://agenttest/multiline
